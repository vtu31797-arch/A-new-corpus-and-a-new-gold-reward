        "\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Day 4 corpus: Technology domain\n",
        "corpus = [\n",
        "    \"The server processes requests quickly.\",\n",
        "    \"Our team deployed the application yesterday.\",\n",
        "    \"The system stores user data securely in the cloud.\",\n",
        "    \"We improved performance by optimizing database queries.\",\n",
        "    \"The software is really very good and useful for everyone.\",\n",
        "    \"Engineers monitor network traffic to detect unusual activity.\"\n",
        "]\n",
        "\n",
        "# 2. Adjustable values\n",
        "MIN_WORDS = 8\n",
        "MAX_WORDS = 15\n",
        "\n",
        "WEIGHT_LENGTH = 0.40\n",
        "WEIGHT_ACTIVE = 0.35\n",
        "WEIGHT_CONCISE = 0.25\n",
        "\n",
        "\n",
        "# 3. Calculate sentence length score\n",
        "def length_score(sentence):\n",
        "    words = len(sentence.split())\n",
        "\n",
        "    if MIN_WORDS <= words <= MAX_WORDS:\n",
        "        return 1.0\n",
        "    elif words < MIN_WORDS:\n",
        "        return words / MIN_WORDS\n",
        "    else:\n",
        "        return MAX_WORDS / words\n",
        "\n",
        "\n",
        "# 4. Active voice heuristic\n",
        "def active_score(sentence):\n",
        "    passive_phrases = [\n",
        "        \"was deployed\",\n",
        "        \"was processed\",\n",
        "        \"was stored\",\n",
        "        \"were created\",\n",
        "        \"is monitored\"\n",
        "    ]\n",
        "\n",
        "    sentence = sentence.lower()\n",
        "\n",
        "    for phrase in passive_phrases:\n",
        "        if phrase in sentence:\n",
        "            return 0.0\n",
        "\n",
        "    return 1.0\n",
        "\n",
        "\n",
        "# 5. Conciseness score\n",
        "def concise_score(sentence):\n",
        "    filler_words = [\"really\", \"very\", \"basically\", \"actually\"]\n",
        "\n",
        "    sentence = sentence.lower()\n",
        "    penalties = sum(sentence.count(word) for word in filler_words)\n",
        "\n",
        "    return max(0.0, 1.0 - 0.25 * penalties)\n",
        "\n",
        "\n",
        "# 6. Gold reward function\n",
        "def gold_reward(sentence):\n",
        "    total_weight = (\n",
        "        WEIGHT_LENGTH + WEIGHT_ACTIVE + WEIGHT_CONCISE\n",
        "    )\n",
        "\n",
        "    if total_weight <= 0:\n",
        "        raise ValueError(\"At least one weight must be positive.\")\n",
        "\n",
        "    reward = (\n",
        "        WEIGHT_LENGTH * length_score(sentence)\n",
        "        + WEIGHT_ACTIVE * active_score(sentence)\n",
        "        + WEIGHT_CONCISE * concise_score(sentence)\n",
        "    ) / total_weight\n",
        "\n",
        "    return round(reward, 3)\n",
        "\n",
        "\n",
        "# 7. Calculate rewards\n",
        "rewards = [gold_reward(s) for s in corpus]\n",
        "\n",
        "print(\"DAY 4: TECHNOLOGY CORPUS\")\n",
        "print(\"-\" * 55)\n",
        "\n",
        "for i, sentence in enumerate(corpus):\n",
        "    print(f\"{i + 1}. {sentence}\")\n",
        "    print(f\"   Gold reward: {rewards[i]}\")\n",
        "\n",
        "# 8. Plot the graph\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "bars = plt.bar(\n",
        "    [f\"Sentence {i + 1}\" for i in range(len(corpus))],\n",
        "    rewards\n",
        ")\n",
        "\n",
        "plt.ylim(0, 1.1)\n",
        "plt.xlabel(\"Corpus Sentences\")\n",
        "plt.ylabel(\"Gold Reward\")\n",
        "plt.title(\"Gold Reward for Concise Technology Writing\")\n",
        "plt.grid(axis=\"y\", linestyle=\"--\", alpha=0.4)\n",
        "\n",
        "# Display reward values above bars\n",
        "for bar, reward in zip(bars, rewards):\n",
        "    plt.text(\n",
        "        bar.get_x() + bar.get_width() / 2,\n",
        "        bar.get_height() + 0.02,\n",
        "        str(reward),\n",
        "        ha=\"center\"\n",
        "    )\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
